*.zip
*.rar
*.7z
*.tar
*.gz
*.bz
*.bzip
*.bzip2
*.bz2
*.tgz
*.arj
*.ace
*.lha
*.iso
*.Z
*.xz

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
*.mp3
*.aac
*.m4a
*.wma

# Auxiliary Files
*.obj
*.wixobj
*.wixpdb
*.tmp
*.log
*.bak
*.o
*.so

# Windows Installer files
*.cab
*.msi
*.msm
*.msp
*.msu

# Linux Installer Files
*.deb
*.rpm

# OS Images
*.iso
*.ova
*.ovf
*.vmdk
*.vdi
*.vhd
*.vhdx

# Windows shortcuts
# *.lnk

